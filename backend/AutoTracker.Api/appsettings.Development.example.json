{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5433;Database=autotrackerdb;Username=YOUR_USERNAME;Password=YOUR_PASSWORD"
  },

  "Jwt": {
    "Key": "YOUR_DEVELOPMENT_SECRET_KEY",
    "Issuer": "AutoTrackerApi",
    "Audience": "AutoTrackerClient"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "Resend": {
    "ApiKey": "your-resend-api-key"
  },

  "Frontend": {
    "BaseUrl": "http://localhost:5173"
  },

  "AllowedHosts": "*"
}
